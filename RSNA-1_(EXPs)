/td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>1.2.826.0.1.3680043.8.498.11382021393803389951...</td>\n      <td>1.2.826.0.1.3680043.8.498.91903627435354016135...</td>\n      <td>1.0</td>\n      <td>1.0</td>\n      <td>0.0</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":4},{"cell_type":"markdown","source":"## 3. DICOM decoding and sample visualization\nCompressed DICOMs may need JPEG decoding libraries. We sort by `ImagePositionPatient` along the slice direction where possible, falling back to `InstanceNumber`. Pixel values are converted to float and robustly normalized per slice. This is an approximation rather than a full clinical DICOM processing pipeline.","metadata":{}},{"cell_type":"code","source":"def sorted_dicoms(folder):\n    items=[]\n    for f in Path(folder).glob('*.dcm'):\n        try:\n            ds=pydicom.dcmread(str(f),stop_before_pixels=True)\n            ipp=getattr(ds,'ImagePositionPatient',None)\n            ori=getattr(ds,'ImageOrientationPatient',None)\n            if ipp is not None and ori is not None:\n                normal=np.cross(np.asarray(ori[:3],dtype=float),np.asarray(ori[3:],dtype=float))\n                key=float(np.dot(np.asarray(ipp,dtype=float),normal))\n            else: key=float(getattr(ds,'InstanceNumber',0))\n            items.append((key,f))\n        except Exception as e: warnings.warn(f'Metadata read failed: {f.name}: {e}')\n    return [f for _,f in sorted(items,key=lambda x:x[0])]\n\ndef read_slice(f):\n    ds=pydicom.dcmread(str(f))\n    x=ds.pixel_array.astype(np.float32)\n    if x.ndim==3: x=x[0]  # rare multi-frame: first frame only\n    x=x*float(getattr(ds,'RescaleSlope',1))+float(getattr(ds,'RescaleIntercept',0))\n    if getattr(ds,'PhotometricInterpretation','')=='MONOCHROME1': x=x.max()-x\n    lo,hi=np.percentile(x,[1,99]); x=np.clip((x-lo)/(hi-lo+1e-6),0,1)\n    return x\n\nexample=selected.iloc[0]; paths=sorted_dicoms(example.series_path)\nprint('Example slices:',len(paths))\nfig,axes=plt.subplots(1,4,figsize=(12,3))\nfor ax,j in zip(axes,np.linspace(0,len(paths)-1,4).astype(int)):\n    ax.imshow(read_slice(paths[j]),cmap='gray');ax.set_title(f'Slice {j+1}');ax.axis('off')\nplt.tight_layout();plt.savefig(OUT/'example_mri.png',dpi=160);plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-27T17:51:42.311878Z","iopub.execute_input":"2026-10-27T17:51:42.312552Z","iopub.status.idle":"2026-10-27T17:51:43.841532Z","shell.execute_reply.started":"2026-10-27T17:51:42.312524Z","shell.execute_reply":"2026-10-27T17:51:43.840037Z"}},"outputs":[{"name":"stdout","text":"Example slices: 36\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x300 with 4 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":5},{"cell_type":"markdown","source":"## 4. Train-validation split\nAll slices of a study stay in the same split. This is a study-level holdout; it does not guarantee patient-level or site-level independence because patient/site identifiers are not available here. For a publishable study, verify those groupings if metadata permits.","metadata":{}},{"cell_type":"code","source":"def safe_split(df):\n    # Stratify on a joint label pattern only when every pattern has at least 2 members.\n    pattern=df[LABELS].astype(int).astype(str).agg(''.join,axis=1)\n    strat=pattern if pattern.value_counts().min()>=2 and pattern.nunique()<=int(np.ceil(len(df)*.2)) else None\n    return train_test_split(df,test_size=.2,random_state=SEED,stratify=strat)\ntr,va=safe_split(selected)\ntr=tr.reset_index(drop=True);va=va.reset_index(drop=True)\nassert set(tr.StudyInstanceUID).isdisjoint(set(va.StudyInstanceUID))\ntr.to_csv(OUT/'train_split.csv',index=False);va.to_csv(OUT/'val_split.csv',index=False)\nprint('Train:',len(tr),'Validation:',len(va))\nprint('Train positive:',tr[LABELS].sum().to_dict());print('Validation positive:',va[LABELS].sum().to_dict())\nfor label in LABELS:\n    if va[label].nunique()<2: warnings.warn(f'Validation has one class for {label}; ROC-AUC undefined. Increase sample size.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-27T17:51:45.120867Z","iopub.execute_input":"2026-10-27T17:51:45.121538Z","iopub.status.idle":"2026-10-27T17:51:45.155923Z","shell.execute_reply.started":"2026-10-27T17:51:45.12151Z","shell.execute_reply":"2026-10-27T17:51:45.155077Z"}},"outputs":[{"name":"stdout","text":"Train: 46 Validation: 12\nTrain positive: {'ACL': 20.0, 'Medial Meniscus': 21.0, 'Effusion': 27.0}\nValidation positive: {'ACL': 4.0, 'Medial Meniscus': 5.0, 'Effusion': 8.0}\n","output_type":"stream"}],"execution_count":6},{"cell_type":"markdown","source":"## 5. PyTorch dataset and model\nEach study produces `SLICES` grayscale slices resized to 224×224. A shared ResNet18 processes slices independently, then **mean-pools their feature vectors** to produce one prediction per study. This avoids incorrectly treating individual slices as independent labeled studies.","metadata":{}},{"cell_type":"code","source":"import torch.nn.functional as F\nclass KneeDataset(Dataset):\n    def __init__(self,frame): self.frame=frame.reset_index(drop=True)\n    def __len__(self): return len(self.frame)\n    def __getitem__(self,i):\n        r=self.frame.iloc[i]; fs=sorted_dicoms(r.series_path)\n        if not fs: raise RuntimeError(f'Empty series {r.series_path}')\n        idx=np.linspace(0,len(fs)-1,SLICES).round().astype(int)\n        images=[]\n        for j in idx:\n            x=read_slice(fs[j]); x=torch.from_numpy(x).float()[None,None]\n            x=F.interpolate(x,size=(IMAGE_SIZE,IMAGE_SIZE),mode='bilinear',align_corners=False)[0]\n            images.append(x)\n        x=torch.stack(images) # S,1,H,W\n        y=torch.tensor(r[LABELS].astype(float).to_numpy(),dtype=torch.float32)\n        return x,y\n\nclass KneeNet(nn.Module):\n    def __init__(self,pretrained_path=None,freeze=True):\n        super().__init__()\n        backbone=models.resnet18(weights=None)\n        if pretrained_path:\n            state=torch.load(pretrained_path,map_location='cpu',weights_only=True)\n            if isinstance(state,dict) and 'state_dict' in state:state=state['state_dict']\n            state={k.replace('module.',''):v for k,v in state.items()}\n            missing,unexpected=backbone.load_state_dict(state,strict=False)\n            print('Pretrained loaded; missing:',missing,'unexpected:',unexpected)\n        else:\n            print('No pretrained weights: ResNet18 is randomly initialized. For transfer learning attach ImageNet weights.')\n            freeze=False  # never freeze random features\n        backbone.fc=nn.Identity()\n        self.encoder=backbone\n        self.head=nn.Linear(512,len(LABELS))\n        if freeze:\n            for param in self.encoder.parameters():param.requires_grad=False\n        self.freeze=freeze\n    def forward(self,x):\n        b,s,c,h,w=x.shape\n        x=x.reshape(b*s,c,h,w).repeat(1,3,1,1)\n        # ImageNet normalization for pretrained models (also used consistently otherwise)\n        mean=x.new_tensor([.485,.456,.406])[None,:,None,None]\n        std=x.new_tensor([.229,.224,.225])[None,:,None,None]\n        x=(x-mean)/std\n        z=self.encoder(x).reshape(b,s,512).mean(1)\n        return self.head(z)\n\nmodel=KneeNet(PRETRAINED_WEIGHTS_PATH,FREEZE_BACKBONE).to(DEVICE)\nprint('Trainable parameters:',sum(p.numel() for p in model.parameters() if p.requires_grad))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-27T17:51:47.488938Z","iopub.execute_input":"2026-10-27T17:51:47.489345Z","iopub.status.idle":"2026-10-27T17:51:48.087041Z","shell.execute_reply.started":"2026-10-27T17:51:47.489309Z","shell.execute_reply":"2026-10-27T17:51:48.086039Z"}},"outputs":[{"name":"stdout","text":"No pretrained weights: ResNet18 is randomly initialized. For transfer learning attach ImageNet weights.\nTrainable parameters: 11178051\n","output_type":"stream"}],"execution_count":7},{"cell_type":"markdown","source":"## 6. Train and save best checkpoint\n`BCEWithLogitsLoss` handles independent labels. `pos_weight` is estimated only from the training set. Use validation macro-AUC when defined; otherwise use validation loss for checkpoint selection. Do not report the best validation checkpoint as an unbiased final test estimate.","metadata":{}},{"cell_type":"code","source":"train_ds=KneeDataset(tr);val_ds=KneeDataset(va)\ntrain_loader=DataLoader(train_ds,batch_size=BATCH_SIZE,shuffle=True,num_workers=2,pin_memory=DEVICE.type=='cuda')\nval_loader=DataLoader(val_ds,batch_size=BATCH_SIZE,shuffle=False,num_workers=2,pin_memory=DEVICE.type=='cuda')\npos=tr[LABELS].sum().to_numpy(dtype=float);neg=len(tr)-pos\nweights=np.where(pos>0,neg/np.maximum(pos,1),1.0)\nloss_fn=nn.BCEWithLogitsLoss(pos_weight=torch.tensor(weights,dtype=torch.float32,device=DEVICE))\noptimizer=torch.optim.AdamW(filter(lambda p:p.requires_grad,model.parameters()),lr=LR)\nscaler=torch.amp.GradScaler('cuda',enabled=DEVICE.type=='cuda')\n\ndef run_epoch(loader,training):\n    model.train(training); total=0; ys=[];ps=[]\n    for x,y in loader:\n        x=x.to(DEVICE);y=y.to(DEVICE)\n        if training: optimizer.zero_grad(set_to_none=True)\n        with torch.set_grad_enabled(training):\n            with torch.autocast(device_type=DEVICE.type,enabled=DEVICE.type=='cuda'):\n                logits=model(x);loss=loss_fn(logits,y)\n            if training:\n                scaler.scale(loss).backward();scaler.step(optimizer);scaler.update()\n        total+=float(loss.detach())*len(y)\n        ys.append(y.detach().cpu().numpy());ps.append(torch.sigmoid(logits.detach()).cpu().numpy())\n    y=np.concatenate(ys);pred=np.concatenate(ps)\n    aucs=[roc_auc_score(y[:,j],pred[:,j]) if len(np.unique(y[:,j]))==2 else np.nan for j in range(len(LABELS))]\n    macro=float(np.nanmean(aucs)) if np.isfinite(aucs).any() else float('nan')\n    return total/len(loader.dataset),macro,y,pred\n\nhistory=[];best=-float('inf')\nfor epoch in range(1,EPOCHS+1):\n    start=time.time()\n    tl,ta,_,_=run_epoch(train_loader,True)\n    vl,auc,_,_=run_epoch(val_loader,False)\n    quality=auc if np.isfinite(auc) else -vl\n    history.append({'epoch':epoch,'train_loss':tl,'val_loss':vl,'train_auc':ta,'val_auc':auc,'seconds':time.time()-start})\n    print(f'Epoch {epoch}: train_loss={tl:.4f} val_loss={vl:.4f} val_macro_auc={auc:.4f}')\n    if quality>best:\n        best=quality\n        torch.save({'model':model.state_dict(),'labels':LABELS,'slices':SLICES,'image_size':IMAGE_SIZE,'freeze':model.freeze,'pretrained_path_used':bool(PRETRAINED_WEIGHTS_PATH)},OUT/'best.pt')\npd.DataFrame(history).to_csv(OUT/'history.csv',index=False)\nfig,ax=plt.subplots(figsize=(7,4));ax.plot([h['epoch'] for h in history],[h['train_loss'] for h in history],label='Train');ax.plot([h['epoch'] for h in history],[h['val_loss'] for h in history],label='Validation');ax.set(xlabel='Epoch',ylabel='Loss',title='Training history');ax.legend();plt.tight_layout();plt.savefig(OUT/'training_curve.png',dpi=160);plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-27T17:51:57.054102Z","iopub.execute_input":"2026-10-27T17:51:57.054556Z","iopub.status.idle":"2026-10-27T17:52:36.364973Z","shell.execute_reply.started":"2026-10-27T17:51:57.054529Z","shell.execute_reply":"2026-10-27T17:52:36.36416Z"}},"outputs":[{"name":"stdout","text":"Epoch 1: train_loss=0.7752 val_loss=19.9350 val_macro_auc=0.5920\nEpoch 2: train_loss=0.7346 val_loss=2.1640 val_macro_auc=0.4155\nEpoch 3: train_loss=0.7029 val_loss=1.5559 val_macro_auc=0.4345\nEpoch 4: train_loss=0.6952 val_loss=2.1156 val_macro_auc=0.4667\nEpoch 5: train_loss=0.7362 val_loss=1.7676 val_macro_auc=0.4345\nEpoch 6: train_loss=0.6935 val_loss=0.7266 val_macro_auc=0.4753\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 700x400 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":8},{"cell_type":"markdown","source":"## 7. Validation report\nAUC evaluates ranking; threshold-based metrics use a **fixed 0.5 threshold**, which is not necessarily optimal. In a small dataset, confidence intervals may be wide. AUC is undefined for a label if validation has only one class.","metadata":{}},{"cell_type":"code","source":"ckpt=torch.load(OUT/'best.pt',map_location=DEVICE,weights_only=True)\nmodel.load_state_dict(ckpt['model']);model.eval()\n_,macro,y,prob=run_epoch(val_loader,False)\nreport=[]\nfig,axes=plt.subplots(1,3,figsize=(13,4))\nfor j,label in enumerate(LABELS):\n    truth=y[:,j].astype(int);pred=(prob[:,j]>=.5).astype(int)\n    pr,rc,f1,_=precision_recall_fscore_support(truth,pred,average='binary',zero_division=0)\n    auc=roc_auc_score(truth,prob[:,j]) if len(np.unique(truth))==2 else np.nan\n    report.append({'label':label,'n':len(truth),'positives':int(truth.sum()),'accuracy':accuracy_score(truth,pred),'precision':pr,'recall':rc,'f1':f1,'roc_auc':auc})\n    ConfusionMatrixDisplay(confusion_matrix(truth,pred,labels=[0,1]),display_labels=['No','Yes']).plot(ax=axes[j],colorbar=False)\n    axes[j].set_title(label)\nplt.tight_layout();plt.savefig(OUT/'confusion_matrices.png',dpi=160);plt.show()\nmetrics=pd.DataFrame(report);display(metrics);metrics.to_csv(OUT/'metrics.csv',index=False)\nfig,ax=plt.subplots(figsize=(6,5))\nfor j,label in enumerate(LABELS):\n    if len(np.unique(y[:,j]))==2:\n        fpr,tpr,_=roc_curve(y[:,j],prob[:,j]);ax.plot(fpr,tpr,label=f'{label} (AUC {metrics.iloc[j].roc_auc:.3f})')\nax.plot([0,1],[0,1],'--',color='gray');ax.set(xlabel='False positive rate',ylabel='True positive rate',title=f'ROC curves — macro AUC {macro:.3f}');ax.legend();plt.tight_layout();plt.savefig(OUT/'roc_curves.png',dpi=160);plt.show()\npreds=va[['StudyInstanceUID']+LABELS].copy()\nfor j,label in enumerate(LABELS):preds['pred_'+label]=prob[:,j]\npreds.to_csv(OUT/'validation_predictions.csv',index=False)\nprint('Validation macro ROC-AUC:',macro)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-27T17:52:36.366692Z","iopub.execute_input":"2026-10-27T17:52:36.366929Z","iopub.status.idle":"2026-10-27T17:52:38.133681Z","shell.execute_reply.started":"2026-10-27T17:52:36.366906Z","shell.execute_reply":"2026-10-27T17:52:38.132721Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1300x400 with 3 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"             label   n  positives  accuracy  precision  recall   f1   roc_auc\n0              ACL  12          4  0.333333   0.333333     1.0  0.5  0.500000\n1  Medial Meniscus  12          5  0.583333   0.000000     0.0  0.0  0.557143\n2         Effusion  12          8  0.333333   0.000000     0.0  0.0  0.718750","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>label</th>\n      <th>n</th>\n      <th>positives</th>\n      <th>accuracy</th>\n      <th>precision</th>\n      <th>recall</th>\n      <th>f1</th>\n      <th>roc_auc</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>ACL</td>\n      <td>12</td>\n      <td>4</td>\n      <td>0.333333</td>\n      <td>0.333333</td>\n      <td>1.0</td>\n      <td>0.5</td>\n      <td>0.500000</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>Medial Meniscus</td>\n      <td>12</td>\n      <td>5</td>\n      <td>0.583333</td>\n      <td>0.000000</td>\n      <td>0.0</td>\n      <td>0.0</td>\n      <td>0.557143</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>Effusion</td>\n      <td>12</td>\n      <td>8</td>\n      <td>0.333333</td>\n      <td>0.000000</td>\n      <td>0.0</td>\n      <td>