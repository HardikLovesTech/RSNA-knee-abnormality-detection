e,"execution":{"iopub.status.busy":"2026-10-28T09:05:06.556261Z","iopub.execute_input":"2026-10-28T09:05:06.556653Z","iopub.status.idle":"2026-10-28T09:05:07.337013Z","shell.execute_reply.started":"2026-10-28T09:05:06.556628Z","shell.execute_reply":"2026-10-28T09:05:07.336207Z"}},"outputs":[{"name":"stdout","text":"Downloading: \"https://download.pytorch.org/models/resnet18-f37072fd.pth\" to /root/.cache/torch/hub/checkpoints/resnet18-f37072fd.pth\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 44.7M/44.7M [00:00<00:00, 185MB/s] \n","output_type":"stream"},{"name":"stdout","text":"Pretrained ResNet18 saved successfully.\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"\nimport torch\nfrom torchvision.models import resnet18\n\n# Replace this with the path printed by Step 1,\n# or use the checkpoint created in Step 2.\nWEIGHTS_PATH = \"/kaggle/working/resnet18_imagenet.pth\"\n\nstate = torch.load(\n    WEIGHTS_PATH,\n    map_location=\"cpu\",\n    weights_only=True\n)\n\nif isinstance(state, dict) and \"state_dict\" in state:\n    state = state[\"state_dict\"]\n\nmodel = resnet18(weights=None)\n\n# Strict loading verifies the expected layer names and shapes.\nmodel.load_state_dict(state, strict=True)\n\nprint(\"SUCCESS: ResNet18 pretrained weights loaded.\")\nprint(\"Parameters:\", sum(p.numel() for p in model.parameters()))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-28T09:05:08.556788Z","iopub.execute_input":"2026-10-28T09:05:08.557242Z","iopub.status.idle":"2026-10-28T09:05:08.766762Z","shell.execute_reply.started":"2026-10-28T09:05:08.557214Z","shell.execute_reply":"2026-10-28T09:05:08.766142Z"}},"outputs":[{"name":"stdout","text":"SUCCESS: ResNet18 pretrained weights loaded.\nParameters: 11689512\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"\n# ============================================================\n# PHASE 5 — TRANSFER LEARNING EXPERIMENTS\n#\n# E4: ImageNet ResNet18 + frozen backbone\n# E5: ImageNet ResNet18 + full fine-tuning\n#\n# Reuses Phase 4 imports, dataframes, Dataset, and loss.\n# No CSV files are reloaded.\n#\n# Evaluation:\n#   Study-level validation macro ROC-AUC\n#   Per-label ROC-AUC\n#   Training and validation loss\n#   Training time\n#\n# IMPORTANT:\n#   The validation set is used for checkpoint selection.\n#   These results are NOT independent test results.\n# ============================================================\n\n# ------------------------------------------------------------\n# 0. CHECK EXISTING NOTEBOOK STATE\n# ------------------------------------------------------------\n\nrequired = [\n    \"verified_train\",\n    \"verified_val\",\n    \"KneeDataset\",\n    \"masked_loss\",\n    \"LABELS\",\n    \"DEVICE\",\n    \"SEED\",\n    \"OUT\",\n    \"WEIGHTS_PATH\",\n]\n\nmissing = [name for name in required if name not in globals()]\n\nif missing:\n    raise RuntimeError(\n        \"Missing variables/functions: \" + \", \".join(missing)\n        + \"\\nRun the relevant earlier cells first.\"\n    )\n\nweights_path = Path(WEIGHTS_PATH)\n\nif not weights_path.is_file():\n    raise FileNotFoundError(\n        f\"Pretrained checkpoint not found: {weights_path}\"\n    )\n\nPHASE5_OUT = Path(OUT) / \"phase5_transfer_learning\"\nPHASE5_OUT.mkdir(parents=True, exist_ok=True)\n\n# ------------------------------------------------------------\n# 1. EXPERIMENT CONFIGURATION\n# ------------------------------------------------------------\n\nP5_EPOCHS = 10\nP5_BATCH_SIZE = 2\nP5_SLICES = SLICES\nP5_IMAGE_SIZE = SIZE\n\n# Both experiments use the same data.\n# Only backbone freezing and learning rate differ.\n\nP5_EXPERIMENTS = {\n    \"E4_frozen_pretrained\": {\n        \"freeze\": True,\n        \"lr\": 1e-3,\n    },\n    \"E5_finetuned_pretrained\": {\n        \"freeze\": False,\n        \"lr\": 1e-4,\n    },\n}\n\nprint(\"=\" * 65)\nprint(\"PHASE 5 — TRANSFER LEARNING\")\nprint(\"=\" * 65)\nprint(\"Device:\", DEVICE)\nprint(\"Pretrained weights:\", weights_path)\nprint(\"Verified training studies:\", len(verified_train))\nprint(\"Verified validation studies:\", len(verified_val))\nprint(\"Epochs:\", P5_EPOCHS)\n\n# ------------------------------------------------------------\n# 2. REUSE EXISTING DATASET\n# ------------------------------------------------------------\n\np5_train_loader = DataLoader(\n    KneeDataset(verified_train),\n    batch_size=P5_BATCH_SIZE,\n    shuffle=True,\n    num_workers=0,\n    pin_memory=(str(DEVICE).startswith(\"cuda\"))\n)\n\np5_val_loader = DataLoader(\n    KneeDataset(verified_val),\n    batch_size=P5_BATCH_SIZE,\n    shuffle=False,\n    num_workers=0,\n    pin_memory=(str(DEVICE).startswith(\"cuda\"))\n)\n\n# ------------------------------------------------------------\n# 3. PRETRAINED MODEL\n# ------------------------------------------------------------\n\nclass PretrainedKneeResNet(nn.Module):\n\n    def __init__(self, checkpoint, freeze=False):\n        super().__init__()\n\n        # Construct standard ImageNet ResNet18.\n        backbone = resnet18(weights=None)\n\n        state = torch.load(\n            checkpoint,\n            map_location=\"cpu\",\n            weights_only=True\n        )\n\n        # Support checkpoints with nested state_dict.\n        if isinstance(state, dict) and \"state_dict\" in state:\n            state = state[\"state_dict\"]\n\n        # Remove DataParallel prefixes if present.\n        state = {\n            k.removeprefix(\"module.\"): v\n            for k, v in state.items()\n        }\n\n        # Strict loading ensures architecture compatibility.\n        backbone.load_state_dict(state, strict=True)\n\n        # Replace ImageNet classifier with feature extraction.\n        feature_dim = backbone.fc.in_features\n        backbone.fc = nn.Identity()\n\n        self.encoder = backbone\n        self.freeze = freeze\n\n        if freeze:\n            for parameter in self.encoder.parameters():\n                parameter.requires_grad = False\n\n        # Three independent abnormality outputs.\n        self.head = nn.Linear(\n            feature_dim,\n            len(LABELS)\n        )\n\n    def forward(self, images):\n\n        # Input: [B, S, 1, H, W]\n        b, s, c, h, w = images.shape\n\n        images = images.float()\n        images = images.reshape(b * s, c, h, w)\n\n        # Convert grayscale MRI to 3 channels.\n        if c == 1:\n            images = images.repeat(1, 3, 1, 1)\n\n        # Standard ImageNet normalization.\n        mean = images.new_tensor(\n            [0.485, 0.456, 0.406]\n        )[None, :, None, None]\n\n        std = images.new_tensor(\n            [0.229, 0.224, 0.225]\n        )[None, :, None, None]\n\n        images = (images - mean) / std\n\n        # Frozen encoder must stay in evaluation mode,\n        # including BatchNorm running statistics.\n        if self.freeze:\n            with torch.no_grad():\n                features = self.encoder(images)\n        else:\n            features = self.encoder(images)\n\n        # Aggregate features across MRI slices.\n        features = features.reshape(b, s, -1)\n        features = features.mean(dim=1)\n\n        return self.head(features)\n\n# ------------------------------------------------------------\n# 4. EVALUATION FUNCTION\n# ------------------------------------------------------------\n\n@torch.no_grad()\ndef p5_evaluate(model, loader):\n\n    model.eval()\n\n    losses = []\n    predictions = []\n    truths = []\n\n    for images, targets, mask in loader:\n\n        images = images.to(\n            DEVICE, dtype=torch.float32\n        )\n\n        targets = targets.to(\n            DEVICE, dtype=torch.float32\n        )\n\n        mask = mask.to(\n            DEVICE, dtype=torch.float32\n        )\n\n        logits = model(images)\n\n        loss = masked_loss(\n            logits, targets, mask\n        )\n\n        losses.append(\n            (loss.item(), float(mask.sum().item()))\n        )\n\n        predictions.append(\n            torch.sigmoid(logits).cpu().numpy()\n        )\n\n        truths.append(\n            targets.cpu().numpy()\n        )\n\n    probabilities = np.concatenate(predictions)\n    targets = np.concatenate(truths)\n\n    aucs = {}\n\n    for j, label in enumerate(LABELS):\n\n        if len(np.unique(targets[:, j])) == 2:\n            aucs[label] = roc_auc_score(\n                targets[:, j],\n                probabilities[:, j]\n            )\n        else:\n            aucs[label] = np.nan\n\n    valid_aucs = [\n        value for value in aucs.values()\n        if np.isfinite(value)\n    ]\n\n    macro_auc = (\n        float(np.mean(valid_aucs))\n        if len(valid_aucs) == len(LABELS)\n        else np.nan\n    )\n\n    total_weight = sum(weight for _, weight in losses)\n\n    val_loss = (\n        sum(loss * weight for loss, weight in losses)\n        / max(total_weight, 1)\n    )\n\n    return val_loss, macro_auc, aucs, targets, probabilities\n\n# ------------------------------------------------------------\n# 5. TRAINING FUNCTION\n# ------------------------------------------------------------\n\ndef p5_train(name, config):\n\n    print(\"\\n\" + \"=\" * 65)\n    print(\"EXPERIMENT:\", name)\n    print(\"=\" * 65)\n\n    # Reproducible initialization.\n    random.seed(SEED)\n    np.random.seed(SEED)\n    torch.manual_seed(SEED)\n\n    if torch.cuda.is_available():\n        torch.cuda.manual_seed_all(SEED)\n\n    model = PretrainedKneeResNet(\n        checkpoint=weights_path,\n        freeze=config[\"freeze\"]\n    ).to(DEVICE)\n\n    trainable = sum(\n        p.numel()\n        for p in model.parameters()\n        if p.requires_grad\n    )\n\n    print(\"Trainable parameters:\", trainable)\n\n    optimizer = torch.optim.AdamW(\n        filter(lambda p: p.requires_grad, model.parameters()),\n        lr=config[\"lr\"],\n        weight_decay=1e-4\n    )\n\n    use_amp = str(DEVICE).startswith(\"cuda\")\n\n    scaler = torch.amp.GradScaler(\n        \"cuda\", enabled=use_amp\n    )\n\n    history = []\n    best_auc = -np.inf\n    best_state = None\n    best_epoch = None\n\n    start = time.time()\n\n    for epoch in range(1, P5_EPOCHS + 1):\n\n        model.train()\n\n        # Keep BatchNorm and other encoder modules frozen.\n        if config[\"freeze\"]:\n            model.encoder.eval()\n\n        total_loss = 0.0\n        total_observed = 0.0\n\n        for images, targets, mask in p5_train_loader:\n\n            images = images.to(\n                DEVICE, dtype=torch.float32\n            )\n\n            targets = targets.to(\n                DEVICE, dtype=torch.float32\n            )\n\n            mask = mask.to(\n                DEVICE, dtype=torch.float32\n            )\n\n            optimizer.zero_grad(set_to_none=True)\n\n            with torch.autocast(\n                device_type=\"cuda\",\n                enabled=use_amp\n            ):\n\n                logits = model(images)\n\n                loss = masked_loss(\n                    logits, targets, mask\n                )\n\n            scaler.scale(loss).backward()\n\n            scaler.unscale_(optimizer)\n\n            torch.nn.utils.clip_grad_norm_(\n                filter(\n                    lambda p: p.requires_grad,\n                    model.parameters()\n                ),\n                max_norm=1.0\n            )\n\n            scaler.step(optimizer)\n            scaler.update()\n\n            observed = float(mask.sum().item())\n            total_loss += loss.item() * observed\n            total_observed += observed\n\n        train_loss = total_loss / max(total_observed, 1)\n\n        val_loss, val_auc, label_aucs, _, _ = (\n            p5_evaluate(model, p5_val_loader)\n        )\n\n        history.append({\n            \"Experiment\": name,\n            \"Epoch\": epoch,\n            \"Train_Loss\": train_loss,\n            \"Val_Loss\": val_loss,\n            \"Macro_AUC\": val_auc,\n            **label_aucs\n        })\n\n        print(\n            f\"Epoch {epoch:02d}/{P5_EPOCHS} | \"\n            f\"Train Loss: {train_loss:.4f} | \"\n            f\"Val Loss: {val_loss:.4f} | \"\n            f\"Macro AUC: {val_auc:.4f}\"\n        )\n\n        if np.isfinite(val_auc) and val_auc > best_auc:\n\n            best_auc = val_auc\n            best_epoch = epoch\n\n            best_state = copy.deepcopy(\n                model.state_dict()\n            )\n\n    if best_state is None:\n        raise RuntimeError(\n            \"No valid validation macro-AUC was available. \"\n            \"Check class counts in the validation split.\"\n        )\n\n    checkpoint_path = (\n        PHASE5_OUT / f\"{name}_best.pt\"\n    )\n\n    torch.save({\n        \"model\": best_state,\n        \"experiment\": name,\n        \"labels\": LABELS,\n        \"slices\": P5_SLICES,\n        \"image_size\": P5_IMAGE_SIZE,\n        \"freeze\": config[\"freeze\"],\n        \"best_epoch\": best_epoch,\n        \"best_val_auc\": best_auc,\n    }, checkpoint_path)\n\n    # Evaluate the best checkpoint, not the last epoch.\n    model.load_state_dict(best_state)\n\n    _, _, final_label_aucs, truth, prob = (\n        p5_evaluate(model, p5_val_loader)\n    )\n\n    predictions = verified_val[\n        [\"StudyInstanceUID\"] + LABELS\n    ].copy().reset_index(drop=True)\n\n    for j, label in enumerate(LABELS):\n        predictions[\"pred_\" + label] = prob[:, j]\n\n    predictions.to_csv(\n        PHASE5_OUT / f\"{name}_predictions.csv\",\n        index=False\n    )\n\n    elapsed = time.time() - start\n\n    del model\n    gc.collect()\n\n    if torch.cuda.is_available():\n        torch.cuda.empty_cache()\n\n    return (\n        pd.DataFrame(history),\n        {\n            \"Experiment\": name,\n            \"Best_Epoch\": best_epoch,\n            \"Best_Validation_AUC\": best_auc,\n            \"Training_Seconds\": elapsed,\n            \"Trainable_Parameters\": trainable,\n            **{\n                \"AUC_\" + label: value\n                for label, value in final_label_aucs.items()\n            }\n        }\n    )\n\n# ------------------------------------------------------------\n# 6. RUN E4 AND E5\n# ------------------------------------------------------------\n\np5_histories = []\np5_summaries = []\n\nfor name, config in P5_EXPERIMENTS.items():\n\n    hist, summary = p5_train(name, config)\n\n    p5_histories.append(hist)\n    p5_summaries.append(summary)\n\np5_history = pd.concat(\n    p5_histories, ignore_index=True\n)\n\np5_results = pd.DataFrame(p5_summaries)\n\np5_history.to_csv(\n    PHASE5_OUT / \"phase5_training_history.csv\",\n    index=False\n)\n\np5_results.to_csv(\n    PHASE5_OUT / \"phase5_results.csv\",\n    index=False\n)\n\n# ------------------------------------------------------------\n# 7. COMPARE WITH EXISTING E1 BASELINE\n# ------------------------------------------------------------\n\nbaseline = pd.DataFrame([{\n    \"Experiment\": \"E1_verified_scratch\",\n    \"Best_Validation_AUC\": 0.786173\n}])\n\ncomparison = pd.concat([\n    baseline,\n    p5_results[\n        [\"Experiment\", \"Best_Validation_AUC\"]\n    ]\n], ignore_index=True)\n\nprint(\"\\nFINAL TRANSFER LEARNING COMPARISON\")\ndisplay(comparison)\n\n# ------------------------------------------------------------\n# 8. GENERATE IEEE-READY FIGURES\n# ------------------------------------------------------------\n\nfig, axes = plt.subplots(1, 2, figsize=(13, 5))\n\nfor name, group in p5_history.groupby(\"Experiment\"):\n\n    axes[0].plot(\n        group[\"Epoch\"],\n        group[\"Train_Loss\"],\n        label=name\n    )\n\n    axes[0].plot(\n        group[\"Epoch\"],\n        group[\"Val_Loss\"],\n        linestyle=\"--\",\n        label=name + \" validation\"\n    )\n\n    axes[1].plot(\n        group[\"Epoch\"],\n        group[\"Macro_AUC\"],\n        marker=\"o\",\n        label=name\n    )\n\naxes[0].set_title(\"Transfer learning: loss curves\")\naxes[0].set_xlabel(\"Epoch\")\naxes[0].set_ylabel(\"Loss\")\naxes[0].legend(fontsize=8)\n\naxes[1].set_title(\"Validation macro ROC-AUC\")\naxes[1].set_xlabel(\"Epoch\")\naxes[1].set_ylabel(\"ROC-AUC\")\naxes[1].set_ylim(0, 1)\naxes[1].legend(fontsize=8)\n\nplt.tight_layout()\n\nplt.savefig(\n    PHASE5_OUT / \"phase5_training_curves.png\",\n    dpi=300,\n    bbox_inches=\"tight\"\n)\n\nplt.show()\n\nfig, ax = plt.subplots(figsize=(9, 5))\n\nax.bar(\n    comparison[\"Experiment\"],\n    comparison[\"Best_Validation_AUC\"]\n)\n\nax.set_ylim(0, 1)\nax.set_ylabel(\"Best validation macro ROC-AUC\")\nax.set_title(\"Scratch vs pretrained ResNet18\")\n\nplt.xticks(rotation=15, ha=\"right\")\nplt.tight_layout()\n\nplt.savefig(\n    PHASE5_OUT / \"phase5_model_comparison.png\",\n    dpi=300,\n    bbox_inches=\"tight\"\n)\n\nplt.show()\n\ncomparison.to_csv(\n    PHASE5_OUT / \"phase5_model_comparison.csv\",\n    index=False\n)\n\nprint(\"\\nPHASE 5 COMPLETED\")\nprint(\"Outputs saved to:\", PHASE5_OUT)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-28T09:05:10.930644Z","iopub.execute_input":"2026-10-28T09:05:10.931367Z","iopub.status.idle":"2026-10-28T09:05:10.968903Z","shell.execute_reply.started":"2026-10-28T09:05:10.931342Z","shell.execute_reply":"2026-10-28T09:05:10.967947Z"}},"outputs":[{"traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mRuntimeError\u001b[0m                              Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_49/873440161.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0m\n\u001b[1;32m     38\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m     39\u001b[0m \u001b[0;32mif\u001b[0m \u001b[0mmissing\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m---> 40\u001b[0;31m     raise RuntimeError(\n\u001b[0m\u001b[1;32m     41\u001b[0m    